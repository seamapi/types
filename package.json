{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@seamapi/types",
  "version": "1.1198.0",
  "description": "TypeScript types for the Seam API.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./connect": {
      "types": "./connect.d.ts",
      "default": "./connect.js"
    }
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/seamapi/types",
  "bugs": "https://github.com/seamapi/types/issues",
  "repository": "seamapi/types",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "connect.js",
    "connect.js.map",
    "connect.d.ts",
    "lib",
    "src",
    "!test",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "npm run build:entrypoints",
    "prebuild": "concurrently --raw --group 'tsx src/index.ts' 'tsx src/connect.ts'",
    "postbuild": "concurrently --raw --group 'node ./index.js' 'node ./connect.js'",
    "build:entrypoints": "npm run build:ts",
    "build:ts": "tsc --project tsconfig.build.json",
    "prebuild:ts": "del 'index.*' 'connect.*' lib",
    "postbuild:ts": "tsc-alias --replacer ./tsc-alias-replacer.cjs --project tsconfig.build.json",
    "typecheck": "tsc",
    "docs:build": "typedoc",
    "blueprint": "tsx ./blueprint.ts",
    "postblueprint": "tsx ./blueprint.ts --omit-undocumented",
    "preblueprint": "mkdirp tmp",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore .",
    "postversion": "git push --follow-tags",
    "format": "prettier --write --ignore-path .gitignore .",
    "preformat": "eslint --fix ."
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0 || ^24.11.0 || ^22.12.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.0.0"
    }
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@seamapi/blueprint": "^1.12.0",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^17.21.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "^2.4.2",
    "mkdirp": "^3.0.1",
    "neostandard": "^0.14.1",
    "patch-package": "^8.0.0",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.2",
    "tsx": "^4.6.2",
    "typedoc": "^0.28.7",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
